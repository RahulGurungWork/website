# Copy to deploy/.env on the server (chmod 600). Never commit the real file.
APP_IMAGE=ghcr.io/rahulgurungwork/portfolio:latest

# PostgreSQL container
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=

# Spring Boot app
DB_URL=jdbc:postgresql://db:5432/portfolio
DB_USER=portfolio
DB_PASSWORD=

# Infomaniak SMTP (authenticated, port 587)
MAIL_HOST=mail.infomaniak.com
MAIL_PORT=587
MAIL_USER=rahul@gurung.ch
MAIL_PASSWORD=
CONTACT_RECIPIENT=rahul@gurung.ch

# Admin login (ADR 0005). Generate all three with AdminSetup (README). Keep the single quotes around the hash:
# it contains $ signs. Leave empty to disable the admin login.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=''
ADMIN_TOTP_SECRET=
