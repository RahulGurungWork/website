root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_style = tab
indent_size = 4

[pom.xml]
indent_style = tab
indent_size = 4

[*.html]
indent_style = tab
indent_size = 4

[Caddyfile]
indent_style = tab

[*.sh]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
